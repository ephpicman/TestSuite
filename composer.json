{
    "name": "ephpicman/test-suite",
    "description": "EphpicMan Test Suite.",
    "type": "project",
    "license": "GPL-3-or-later",
    "keywords": [
        "php",
        "testing",
        "WordPress"
    ],
    "homepage": "https://github.com/EphpicMan/TestSuite",
    "support": {
        "issues": "https://github.com/EphpicMan/TestSuite/issues",
        "source": "https://github.com/EphpicMan/TestSuite"
    },
    "authors": [
        {
            "name": "Sina Kuhestani",
            "email": "ephpicman@proton.me",
            "homepage": "https://github.com/EphpicMan",
            "role": "Developer"
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "src/",
            "Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.2",
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^11.5",
        "vimeo/psalm": "^6.16"
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-html build/coverage",
        "analyze:phpstan": "phpstan analyze",
        "analyze:psalm": "psalm",
        "format": "php-cs-fixer fix",
        "format:check": "php-cs-fixer fix --dry-run --diff --verbose",
        "check-all": [
            "@format:check",
            "@analyze:phpstan",
            "@analyze:psalm",
            "@test"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
