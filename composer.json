{
    "name": "ephpicman/td-php",
    "description": "A test-driven PHP project skeleton with PHPUnit, PHPStan, Psalm, and PHP CS Fixer preconfigured.",
    "type": "project",
    "license": "MIT",
    "keywords": [
        "php",
        "skeleton",
        "template",
        "test-driven-development",
        "testing",
        "phpunit",
        "phpstan",
        "psalm",
        "php-cs-fixer"
    ],
    "homepage": "https://github.com/EphpicMan/TD-PHP",
    "support": {
        "issues": "https://github.com/EphpicMan/TD-PHP/issues",
        "source": "https://github.com/EphpicMan/TD-PHP"
    },
    "authors": [
        {
            "name": "Sina Kuhestani",
            "email": "sinakuhestani@gmail.com",
            "homepage": "https://github.com/EphpicMan",
            "role": "Developer"
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^11.5",
        "vimeo/psalm": "^6.16"
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-html build/coverage",
        "analyze:phpstan": "phpstan analyze",
        "analyze:psalm": "psalm",
        "format": "php-cs-fixer fix",
        "format:check": "php-cs-fixer fix --dry-run --diff --verbose",
        "check-all": [
            "@format:check",
            "@analyze:phpstan",
            "@analyze:psalm",
            "@test"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
